  },
  "homepage": "https://github.com/manxcatrumpy/monopoly#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0"
  }
}
